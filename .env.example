# Скопируйте в .env и заполните сами. Файл .env в git не попадает.

# --- База данных (docker compose) ---
POSTGRES_USER=dala
POSTGRES_PASSWORD=
POSTGRES_DB=dala
# Пароль роли agent_reader (только чтение схемы analytics) — для инструмента text-to-SQL
AGENT_DB_PASSWORD=

# Внешняя база (Supabase или свой Postgres) — для make db-apply
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Модели (этап 2) ---
ANTHROPIC_API_KEY=
# OpenAI-совместимый API, например self-hosted vLLM
OPENAI_BASE_URL=
OPENAI_API_KEY=
