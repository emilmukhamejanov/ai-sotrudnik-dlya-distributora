# Скопируйте в .env и заполните сами. Файл .env в git не попадает.

# --- База данных (docker compose) ---
POSTGRES_USER=dala
POSTGRES_PASSWORD=
POSTGRES_DB=dala
# Пароль роли agent_reader (только чтение схемы analytics) — для инструмента text-to-SQL
AGENT_DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Внешняя база (Supabase или свой Postgres) — для make db-apply и сервисного подключения агента
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# Подключение роли агента; по умолчанию собирается из DATABASE_URL + agent_reader/AGENT_DB_PASSWORD
# AGENT_DATABASE_URL=postgresql://agent_reader:password@host:5432/postgres

# --- Модели ---
# anthropic (по умолчанию) или openai — любой OpenAI-совместимый API, в т.ч. self-hosted vLLM/Ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_ROUTER_MODEL=claude-haiku-5-5

# OPENAI_BASE_URL=http://localhost:8001/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=Qwen/Qwen3-32B
# OPENAI_ROUTER_MODEL=

# Цены за 1 млн токенов, USD — чтобы трасса показывала стоимость (иначе только токены)
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# --- Эмбеддинги для RAG (размерность 1024) ---
# hashing — офлайн, без ключей (лексический поиск); openai — OpenAI-совместимый endpoint; voyage — Voyage AI
EMBEDDINGS_PROVIDER=hashing
# EMBEDDINGS_MODEL=BAAI/bge-m3
# EMBEDDINGS_BASE_URL=http://localhost:8002/v1
# EMBEDDINGS_API_KEY=
# VOYAGE_API_KEY=

# --- Битрикс24 ---
# stub — заглушка: действия пишутся в var/bitrix_stub.jsonl; webhook — реальный портал
BITRIX_MODE=stub
# BITRIX_WEBHOOK_URL=https://<портал>.bitrix24.kz/rest/<user_id>/<token>/
